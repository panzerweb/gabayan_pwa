{
  "name": "gabayan-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node mock-api/server.mjs",
    "dev:all": "concurrently -k -n APP,API -c cyan,green \"pnpm dev\" \"pnpm dev:mock\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run tests/unit tests/component",
    "test:contract": "pnpm mock:reset && vitest run tests/contract",
    "test:watch": "vitest",
    "test:e2e": "pnpm mock:reset && playwright test",
    "mock:reset": "node mock-api/reset.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contract && pnpm build"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.103.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "json-server": "0.17.4",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
