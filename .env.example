# The API root the app talks to. It is the only setting that differs between the mock and
# FastAPI; nothing else in the app knows which server answers.
#
# Mock API (pnpm dev:mock), the default:
VITE_API_BASE_URL=http://localhost:3001/api/v1
# FastAPI from aqua-lens-api (its README, "Running the PWA against this API"). Open the app
# on http://127.0.0.1:5173 (pnpm dev --host 127.0.0.1) so the refresh cookie stays same-site:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

MOCK_API_PORT=3001
MOCK_API_DELAY_MS=250
