# Copy this file to .env.android.local before building the APK.
# Android Studio emulator -> host computer:
VITE_API_BASE_URL=http://10.0.2.2:3001/api/v1

# For a physical phone, replace 10.0.2.2 with your computer's LAN IPv4 address.
# Release APKs should use the HTTPS URL of the deployed FastAPI service.
VITE_API_TIMEOUT_MS=8000
